*********************************************************************************************************
*	函 数 名: InitCelluarGpio
*	功能说明: 
*	形    参: 无
*	返 回 值: 无
*********************************************************************************************************
*/
void InitReaderGpio(void)
{
	//GPIO端口设置
	GPIO_InitTypeDef GPIO_Initure;
	
	READER_GPIO_CLK_ENABLE();
	
	/* 配置引脚为推挽输出 */
	GPIO_Initure.Pin = WG0_PIN;
	GPIO_Initure.Mode = GPIO_MODE_INPUT;			/* 下降沿触发 */
	GPIO_Initure.Pull = GPIO_NOPULL;				/* 上下拉电阻不使能 */
	GPIO_Initure.Speed = GPIO_SPEED_FREQ_HIGH;		/* GPIO速度等级 */
	HAL_GPIO_Init(WG0_GPIO_PORT, &GPIO_Initure);	
	
	GPIO_Initure.Pin = WG1_PIN;
	HAL_GPIO_Init(WG1_GPIO_PORT, &GPIO_Initure);
	
	GPIO_Initure.Pull = GPIO_PULLUP;
	GPIO_Initure.Pin = READEREINT_PIN;
	GPIO_Initure.Mode = GPIO_MODE_IT_FALLING;			/* 下降沿触发 */
	HAL_GPIO_Init(READEREINT_GPIO_PORT, &GPIO_Initure);	
		
	__HAL_GPIO_EXTI_CLEAR_IT(READEREINT_PIN);				//清除中断标志位
	HAL_NVIC_SetPriority(EXTI15_10_IRQn,1,3); 				//抢占优先级为2，子优先级为3
	HAL_NVIC_EnableIRQ(EXTI15_10_IRQn);						//使能
}


void DeInitReaderGpio(void)
{
	//GPIO端口设置
	GPIO_InitTypeDef GPIO_Initure;
	
	READER_GPIO_CLK_ENABLE();
	
	/* 配置引脚为推挽输出 */
	GPIO_Initure.Pin = WG0_PIN;
	GPIO_Initure.Mode = GPIO_MODE_ANALOG;			/* 下降沿触发 */
	GPIO_Initure.Pull      = GPIO_NOPULL;
	HAL_GPIO_Init(WG0_GPIO_PORT, &GPIO_Initure);	
	
	GPIO_Initure.Pin = WG1_PIN;
	HAL_GPIO_Init(WG1_GPIO_PORT, &GPIO_Initure);
	
	GPIO_Initure.Pin = READEREINT_PIN;
	HAL_GPIO_Init(READEREINT_GPIO_PORT, &GPIO_Initure);			
}

