/*
*********************************************************************************************************
*	函 数 名: InitLockGpio
*	功能说明: 
*	形    参: 无
*	返 回 值: 无
*********************************************************************************************************
*/
void InitLockGpio(void)
{
	//GPIO端口设置
	GPIO_InitTypeDef GPIO_Initure;
	
	/* 打开GPIO时钟 */
	DOOR_STA_GPIO_CLK_ENABLE();
	
	/* 配置引脚为推挽输出 */
	GPIO_Initure.Pin = DOOR_MAG_STA_PIN;
	GPIO_Initure.Mode = GPIO_MODE_IT_RISING;		/* 下降沿触发 */				
	GPIO_Initure.Pull = GPIO_NOPULL;				/* 上下拉电阻不使能 */
	GPIO_Initure.Speed = GPIO_SPEED_FREQ_HIGH;		/* GPIO速度等级 */
	HAL_GPIO_Init(DOOR_MAG_STA_GPIO_PORT, &GPIO_Initure);		
	
	__HAL_GPIO_EXTI_CLEAR_IT(DOOR_MAG_STA_PIN);				//清除中断标志位
	HAL_NVIC_SetPriority(EXTI9_5_IRQn,1,3); 				//抢占优先级为2，子优先级为3
	HAL_NVIC_EnableIRQ(EXTI9_5_IRQn);						//使能
	
	GPIO_Initure.Mode = GPIO_MODE_INPUT;		/* 下降沿触发 */	
	GPIO_Initure.Pin = DOOR_UNLOCK_STA_PIN;
	HAL_GPIO_Init(DOOR_UNLOCK_STA_GPIO_PORT, &GPIO_Initure);	
	
	GPIO_Initure.Pin = DOOR_LOCK_STA_PIN;
	HAL_GPIO_Init(DOOR_LOCK_STA_GPIO_PORT, &GPIO_Initure);
	
	GPIO_Initure.Pin = DOOR_OPEN_LOCK_PIN;
	GPIO_Initure.Mode = GPIO_MODE_OUTPUT_PP;		/* OUT_PP */
	HAL_GPIO_Init(DOOR_OPEN_LOCK_GPIO_PORT, &GPIO_Initure);	
	LOCK_OPENDISABLE();
}

/*
*********************************************************************************************************
*	函 数 名: DeInitLockGpio
*	功能说明: 
*	形    参: 无
*	返 回 值: 无
*********************************************************************************************************
*/
void DeInitLockGpio(void)
{
	//GPIO端口设置
	GPIO_InitTypeDef GPIO_Initure;
	
	/* 打开GPIO时钟 */
	DOOR_STA_GPIO_CLK_ENABLE();
	
	/* 配置引脚为推挽输出 */
	
	GPIO_Initure.Mode = GPIO_MODE_ANALOG;		/* 下降沿触发 */				
	GPIO_Initure.Pull = GPIO_NOPULL;				/* 上下拉电阻不使能 */
	GPIO_Initure.Pin = DOOR_UNLOCK_STA_PIN;
	HAL_GPIO_Init(DOOR_UNLOCK_STA_GPIO_PORT, &GPIO_Initure);	
	
	GPIO_Initure.Pin = DOOR_LOCK_STA_PIN;
	HAL_GPIO_Init(DOOR_LOCK_STA_GPIO_PORT, &GPIO_Initure);
	
	GPIO_Initure.Pin = DOOR_OPEN_LOCK_PIN;
	HAL_GPIO_Init(DOOR_OPEN_LOCK_GPIO_PORT, &GPIO_Initure);	
}

/*
*********************************************************************************************************
*	函 数 名: InitCelluarGpio
*	功能说明: 
*	形    参: 无
*	返 回 值: 无
*********************************************************************************************************
*/
void InitCelluarGpio(void)
{
	//GPIO端口设置
	GPIO_InitTypeDef GPIO_Initure;
	
	CELLUAR_GPIO_CLK_ENABLE();
	
	/* 配置引脚为推挽输出 */
	GPIO_Initure.Pin = WAKEUPIN_PIN;
	GPIO_Initure.Mode = GPIO_MODE_OUTPUT_PP;			/* 下降沿触发 */
	GPIO_Initure.Pull = GPIO_NOPULL;				/* 上下拉电阻不使能 */
	GPIO_Initure.Speed = GPIO_SPEED_FREQ_HIGH;		/* GPIO速度等级 */
	HAL_GPIO_Init(WAKEUPIN_GPIO_PORT, &GPIO_Initure);	
	CELLUAR_WAKEUP_DISABLE();
	
	GPIO_Initure.Pin = RESETIN_PIN;
	HAL_GPIO_Init(RESETIN_GPIO_PORT, &GPIO_Initure);
	CELLUAR_RESET_DISABLE();
	
	GPIO_Initure.Pin = PWRKEY_PIN;
	HAL_GPIO_Init(PWRKEY_GPIO_PORT, &GPIO_Initure);
	CELLUAR_PWRKEY_DISABLE();
	delay_ms(2000);
	CELLUAR_PWRKEY_ENABLE();
	delay_ms(600);
	CELLUAR_PWRKEY_DISABLE();
	
	GPIO_Initure.Pin = DTR_PIN;
	HAL_GPIO_Init(DTR_GPIO_PORT, &GPIO_Initure);
	CELLUAR_DTR_RESET();
}


void DeInitCelluarGpio(void)
{
	//GPIO端口设置
	GPIO_InitTypeDef GPIO_Initure;
	
	CELLUAR_GPIO_CLK_ENABLE();
	
	/* 配置引脚为推挽输出 */
	GPIO_Initure.Pin = WAKEUPIN_PIN;
	GPIO_Initure.Mode = GPIO_MODE_ANALOG;			/* 下降沿触发 */
	GPIO_Initure.Pull      = GPIO_NOPULL;
	HAL_GPIO_Init(WAKEUPIN_GPIO_PORT, &GPIO_Initure);	
	
	GPIO_Initure.Pin = RESETIN_PIN;
	HAL_GPIO_Init(RESETIN_GPIO_PORT, &GPIO_Initure);
	
	GPIO_Initure.Pin = PWRKEY_PIN;
	HAL_GPIO_Init(PWRKEY_GPIO_PORT, &GPIO_Initure);
	
	GPIO_Initure.Pin = DTR_PIN;
	HAL_GPIO_Init(DTR_GPIO_PORT, &GPIO_Initure);
}


void InitSIMSwitchGpio(void)
{
	//GPIO端口设置
	GPIO_InitTypeDef GPIO_Initure;
	
	SIM_SWITCH_GPIO_CLK_ENABLE();
	
	/* 配置引脚为推挽输出 */
	GPIO_Initure.Pin = SIM_SWITCH_GPIO_PIN;
	GPIO_Initure.Mode = GPIO_MODE_OUTPUT_PP;			/* 下降沿触发 */
	GPIO_Initure.Pull = GPIO_NOPULL;				/* 上下拉电阻不使能 */
	GPIO_Initure.Speed = GPIO_SPEED_FREQ_HIGH;		/* GPIO速度等级 */	
	HAL_GPIO_Init(SIM_SWITCH_GPIO_PORT, &GPIO_Initure);
	
	if(g_SelSIMFlag == SELSIM1)
		SEL_SIM1_ENABLE();
	else
		SEL_SIM2_ENABLE();
}

void DeInitSIMSwitchGpio(void)
{
	//GPIO端口设置
	GPIO_InitTypeDef GPIO_Initure;
	
	SIM_SWITCH_GPIO_CLK_ENABLE();
	
	/* 配置引脚为推挽输出 */
	GPIO_Initure.Pin = SIM_SWITCH_GPIO_PIN;
	GPIO_Initure.Mode = GPIO_MODE_ANALOG;			/* 下降沿触发 */
	GPIO_Initure.Pull      = GPIO_NOPULL;
	HAL_GPIO_Init(SIM_SWITCH_GPIO_PORT, &GPIO_Initure);
}
