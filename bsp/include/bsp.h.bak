/* 开关全局中断的宏 */
#define ENABLE_INT()	__set_PRIMASK(0)	/* 使能全局中断 */
#define DISABLE_INT()	__set_PRIMASK(1)	/* 禁止全局中断 */





void SystemClock_Config(void);
__asm void MSR_MSP(uint32_t addr);

void Error_Handler(void);

#endif /* __BSP_H */


