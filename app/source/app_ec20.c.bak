/****************************************************************************
函数名称: void SendAT(char* s)
功能描述: 
参数输入: 
参数输出: 
返  回  值: 无
其      他: 无
编写者：hly
*****************************************************************************/
void InitNet(void)
{
	g_DataNetOk = 0;
	g_NetAskTime = 1;
	g_NetAskTimeCnt = 6;
	g_Signal = 0;
	CelluarStep = STA_PWR_ON;
	g_Send5ASuc = true;
	g_SendD6Suc = true;
	g_SendIdleBag = 0;
	g_SendToNetFailCount = 0;
	g_NeedRebootEc20Flag = 0;
	g_ATSendCnt = 0;
}

/****************************************************************************
函数名称: void SendAT(char* s)
功能描述: 
参数输入: 
参数输出: 
返  回  值: 无
其      他: 无
编写者：hly
*****************************************************************************/
void SendAT(char* s)
{
	uint16_t len;
	
	if(g_CelluarSleep == 1)
	{
		g_CelluarSleep = 0;
		CELLUAR_DTR_RESET();
		delay_ms(200);
	}
	memset(g_TxBufLP,0,sizeof(g_TxBufLP));
	len = strlen(s);
	memcpy(g_TxBufLP,s,len);
	UartSend(&g_LPUart,g_TxBufLP,len);		
}


/****************************************************************************
函数名称: void SendDatatoSocket_SENDEX(uint8_t id,uint8_t *data,uint16_t datalen)
功能描述: 发送数据到Socket缓存
参数输入: id-socket id *data-数据 datalen-数据长度
参数输出: 
返  回  值: 无
其      他: 无
编写者：hly
*****************************************************************************/
void SendDatatoSocket_SENDEX(uint8_t id,uint8_t *data,uint16_t datalen)
{
	uint8_t tmp;
	uint8_t len;
	uint16_t i;
	
	if(g_CelluarSleep == 1)
	{
		g_CelluarSleep = 0;
		CELLUAR_DTR_RESET();
		delay_ms(200);
	}
					
	memset(g_TxBufLP,0,sizeof(g_TxBufLP));
	
	sprintf((char*)g_TxBufLP,"%s%d,\"",QiSendEx,id);
	len = strlen((char*)g_TxBufLP);
	
	for(i=0;i<datalen;i++)
	{
		tmp = data[i]>>4;
		g_TxBufLP[len+2*i] = Hex2Asc(tmp);
		tmp = data[i]&0x0F;
		g_TxBufLP[len+2*i+1] = Hex2Asc(tmp);
	}
	g_TxBufLP[len+2*datalen] = '"';
	g_TxBufLP[len+2*datalen+1] = 0x0D;
	UartSend(&g_LPUart,(uint8_t*)&g_TxBufLP,len+2*datalen+2);
	CelluarStep = STA_SENDEX_TO_SOCKET;
	g_ATWaitFlag = 1;
	g_ATWaitDelay = 3000;
	g_SocketId = id;
	g_ShouldEnterLowpowerDelay = TIM2->CNT;
	g_LedGToggleFlag = 1;
	g_LedGToggleDelay = TIM2->CNT;
}

/******************************************************************
函数名称: PushSocket(uint8_t id)
功能描述: socket缓存发送到服务器
参数输入: id-socket id
参数输出: 
返  回  值: 无
其      他: 无
编写者：hly
******************************************************************/
void SendDatatoSocket_SEND(uint8_t *data,uint16_t datalen)
{
	if(g_CelluarSleep == 1)
	{
		g_CelluarSleep = 0;
		CELLUAR_DTR_RESET();
		delay_ms(200);
	}
					
	memset(g_TxBufLP,0,sizeof(g_TxBufLP));
	
	memcpy(g_TxBufLP,data,datalen);
	UartSend(&g_LPUart,(uint8_t*)&g_TxBufLP,datalen);

	CelluarStep = STA_SEND_TO_SOCKET;
	g_ATWaitFlag = 1;
	g_ATWaitDelay = 3000;
	g_SocketId = 0;
	g_SendD6Suc = false;
	g_SendD6Delay = TIM2->CNT;
	g_ShouldEnterLowpowerDelay = TIM2->CNT;
}

/****************************************************************************
函数名称: void Login(void)
功能描述: 登陆 发送D2
参数输入: 
参数输出: 
返  回  值: 无
其      他: 无
编写者：hly
*****************************************************************************/
void Login(void)
{	
	memset(tmpsendbuf,0,sizeof(tmpsendbuf));
	
	tmpsendbuf[0] = 0xD2;
	memcpy(tmpsendbuf+1,g_MobileInFlash.mobileno[4],6);	
	if(g_SelSIMFlag == SIM1ONLY)
		tmpsendbuf[6] = (tmpsendbuf[6]&0xF0);
	else
		tmpsendbuf[6] = (tmpsendbuf[6]&0xF1);
	if(g_SelSIMFlag == SELSIM1)
		memcpy(tmpsendbuf+7,&g_ICCID[SELSIM1][2],8);
	else
		memcpy(tmpsendbuf+7,&g_ICCID[SELSIM2][2],8);
	tmpsendbuf[15] = CheckSum(15,tmpsendbuf);	
	
	SendDatatoSocket_SENDEX(datasocketid,tmpsendbuf,16);
	g_ShouldEnterLowpowerDelay = TIM2->CNT;
}

/******************************************************************
函数名称: void SendIdleBag(void)
功能描述: 心跳包
参数输入: 无
参数输出: 
返  回  值: 无
其      他: 无
编写者：hly
******************************************************************/
void SendIdleBag(void)
{
	memset(tmpsendbuf,0,sizeof(tmpsendbuf));
	
	tmpsendbuf[0] = 0x00;
	TimeHexToBcd(&g_BCDTime,(uint8_t*)&g_SysTime);
	memcpy(tmpsendbuf+1,(uint8_t*)&g_BCDTime,5);
	if(CheckNumIsBCD((uint8_t*)g_MobileInFlash.mobileno[4],5) == true)
	{
		memcpy(tmpsendbuf+6,g_MobileInFlash.mobileno[4],6);
		if(g_SelSIMFlag == SIM1ONLY)
			tmpsendbuf[11] = (tmpsendbuf[11]&0xF0);
		else
			tmpsendbuf[11] = (tmpsendbuf[11]&0xF1);
	}
	memcpy(tmpsendbuf+12,g_VersionHex,2);
	SendDatatoSocket_SENDEX(datasocketid,tmpsendbuf,14);
}

/******************************************************************
函数名称: void SendRecSuc(void)
功能描述: 向服务器返回接收成功指令
参数输入: 无
参数输出: 
返  回  值: 无
其      他: 无
编写者：hly
******************************************************************/
void SendRecSuc(void)
{
	memset(tmpsendbuf,0,sizeof(tmpsendbuf));
	tmpsendbuf[0] = 0xDF;
	tmpsendbuf[1] = g_RecD6BagNo&0xFF;
	tmpsendbuf[2] = (g_RecD6BagNo>>8)&0xFF;
	tmpsendbuf[3] = (g_RecD6BagNo>>16)&0xFF;
	tmpsendbuf[4] = (g_RecD6BagNo>>24)&0xFF;
	tmpsendbuf[5] = CheckSum(5,tmpsendbuf);	
	
	SendDatatoSocket_SENDEX(datasocketid,tmpsendbuf,6);	
}

/******************************************************************
函数名称: Bool SendD6Data(void)
功能描述: 发送D6数据
参数输入: 无
参数输出: 
返  回  值: 无
其      他: 无
编写者：hly
******************************************************************/
void SendD6Data(uint8_t *data, uint8_t type)
{
    uint8_t i,cmpbuf[5],tmpmobile[6],tmpmobile1[6],gsm7bit[140],tmptime[6];

	memset(tmpsendbuf,0,sizeof(tmpsendbuf));
    memset(cmpbuf,0,sizeof(cmpbuf));
	
	tmpsendbuf[0] = 0xD6;
	memcpy(tmpsendbuf + 1,g_D6Phone,6);	//接收手机号
	tmpsendbuf[7] = g_SendD6BagNo;						//D6数据包
	if(g_MobileInFlash.Crc16 == CRC16((uint8_t*)&g_MobileInFlash,sizeof(g_MobileInFlash)-2))
    {
        if((CheckNumIsBCD((uint8_t*)g_MobileInFlash.mobileno[4],5) == true)&&
            (memcmp((uint8_t*)g_MobileInFlash.mobileno[4],cmpbuf,5)!=0))
		{
			memcpy(tmpmobile1,g_MobileInFlash.mobileno[4],6);
			if(g_SelSIMFlag == SIM1ONLY)
				tmpmobile1[5] = (tmpsendbuf[5]&0xF0);
			else
				tmpmobile1[5] = (tmpsendbuf[5]&0xF1);
			for(i=0;i<6;i++)
			{
				tmpmobile[i]=CharSwap(tmpmobile1[i]);	//手机号每个字节高低位交换
			}
			for( i = 0 ; i < 6  ; i++ )
			{
				Bcd2Asc(tmpmobile[i],tmpsendbuf+8+2*i);				//转换ASCII码
			}
			if(type == D67bit)
			{
				memset(tmpsendbuf+20,0x30,4);							//协议标识为0，编码方式为00-7bit					
				TimeHexToBcd(&g_BCDTime,(uint8_t*)&g_SysTime);
				tmptime[0] = CharSwap(g_BCDTime.year);
				tmptime[1] = CharSwap(g_BCDTime.month);
				tmptime[2] = CharSwap(g_BCDTime.date);
				tmptime[3] = CharSwap(g_BCDTime.hour);
				tmptime[4] = CharSwap(g_BCDTime.minute);
				tmptime[5] = CharSwap(g_BCDTime.second);
				for( i = 0 ; i < 6  ; i++ )
				{
					Bcd2Asc(tmptime[i],tmpsendbuf+24+2*i);		//年月日时分秒
				}
				i=0;														//时区
				Bcd2Asc(i,tmpsendbuf+36);
				i=160;														//短信长度
				Bcd2Asc(i,tmpsendbuf+38);
				
				for( i = 0 ; i < 80  ; i++ )								//80字节转换ASCII码-160
				{
					Bcd2Asc(*data,g_tmpBuf+2*i);
					data++;
				}
				gsmEncode7bit((char*)g_tmpBuf,gsm7bit,160);					//转换7位编码-140
				for( i = 0 ; i < 140  ; i++ )								//140字节转换ASCII码-280
				{
					Bcd2Asc(gsm7bit[i],tmpsendbuf+40+2*i);
				}
				tmpsendbuf[320] = CheckSum(320,tmpsendbuf);
				CelluarStep = STA_SEND_TO_SOCKET;
				g_QisendStep = 1;
			}
			else
			{
				memset(tmpsendbuf+20,0x30,2);							//协议标识为0
				tmpsendbuf[22] = 0x30;									//编码方式为04-8bit
				tmpsendbuf[23] = 0x34;
				TimeHexToBcd(&g_BCDTime,(uint8_t*)&g_SysTime);
				tmptime[0] = CharSwap(g_BCDTime.year);
				tmptime[1] = CharSwap(g_BCDTime.month);
				tmptime[2] = CharSwap(g_BCDTime.date);
				tmptime[3] = CharSwap(g_BCDTime.hour);
				tmptime[4] = CharSwap(g_BCDTime.minute);
				tmptime[5] = CharSwap(g_BCDTime.second);
				for( i = 0 ; i < 6  ; i++ )
				{
					Bcd2Asc(tmptime[i],tmpsendbuf+24+2*i);		//年月日时分秒
				}
				i=0;														//时区
				Bcd2Asc(i,tmpsendbuf+36);
				i=140;														//短信长度
				Bcd2Asc(i,tmpsendbuf+38);
				
				for( i = 0 ; i < 140  ; i++ )								//140字节转换ASCII码-280
				{
					Bcd2Asc(data[i],tmpsendbuf+40+2*i);
				}
				tmpsendbuf[320] = CheckSum(320,tmpsendbuf);
				CelluarStep = STA_SEND_TO_SOCKET;
				g_QisendStep = 1;
			}
		}
	}
	g_LedGToggleFlag = 1;
	g_LedGToggleDelay = TIM2->CNT;
	
}

/******************************************************************
函数名称: Bool NetSendB9Data(void)
功能描述: 发送B9数据
参数输入: 无
参数输出: 
返  回  值: 无
其      他: 无
编写者：hly
******************************************************************/
bool SendB9Data(void)
{
    uint8_t cmpbuf[5];

    memset(cmpbuf,0,sizeof(cmpbuf));
	memset(tmpsendbuf,0,sizeof(tmpsendbuf));
	
	tmpsendbuf[0] = 0x5A;
    tmpsendbuf[1] = 0xA5;
    tmpsendbuf[2] = 0x20;
    tmpsendbuf[3] = 0; 
	if(ReadRecordFromFlash(&g_StatusDatainFlash,g_tmpBuf) == 1)
	{
		memcpy(tmpsendbuf+4,g_tmpBuf,g_StatusDatainFlash.datalen);
		
		tmpsendbuf[36] = g_Send5ABagNo&0xFF;
		tmpsendbuf[37] = (g_Send5ABagNo>>8)&0xFF;
		tmpsendbuf[38] = (g_Send5ABagNo>>16)&0xFF;
		tmpsendbuf[39] = (g_Send5ABagNo>>24)&0xFF;
		tmpsendbuf[40] = CheckSum(40,tmpsendbuf);

		SendDatatoSocket_SENDEX(datasocketid,tmpsendbuf,41);
		return true;
	}    
	return false;
}

/******************************************************************
函数名称: void NetGetUpdateType(void)
功能描述: 向服务器请求升级类型
参数输入: 无
参数输出: 
返  回  值: 无
其      他: 无
编写者：hly
******************************************************************/
void GetUpdateType(void)
{
	memset(tmpsendbuf,0,sizeof(tmpsendbuf));
	
	tmpsendbuf[0] = 0x5A;
	tmpsendbuf[1] = 0xA5;
	tmpsendbuf[2] = 0x10;
	tmpsendbuf[3] = 0x00;
	tmpsendbuf[4] = 0xEA;
	
	memcpy(tmpsendbuf+5,g_MobileInFlash.mobileno[4],6);
	memcpy(tmpsendbuf+11,(uint8_t*)&g_UpdateCodePageTotal,3);	
	tmpsendbuf[14] = g_VersionHex[0];
	tmpsendbuf[15] = g_VersionHex[1];	
	tmpsendbuf[19] = CheckSum(15,tmpsendbuf+4);	
	tmpsendbuf[24] = CheckSum(24,tmpsendbuf);		
	SendDatatoSocket_SENDEX(updatesocketid,tmpsendbuf,25);
}


/******************************************************************
函数名称: void SendUpdateBag(void)
功能描述: 向服务器请求升级数据包
参数输入: 无
参数输出: 
返  回  值: 无
其      他: 无
编写者：hly
******************************************************************/
void SendUpdateBag(void)
{
	memset(tmpsendbuf,0,sizeof(tmpsendbuf));
	
	tmpsendbuf[0] = 0x5A;
	tmpsendbuf[1] = 0xA5;
	tmpsendbuf[2] = 0x20;
	tmpsendbuf[3] = 0x00;
	tmpsendbuf[4] = 0xEF;	
	
	memcpy(tmpsendbuf+5,g_MobileInFlash.mobileno[4],6);
	memcpy(tmpsendbuf+11,(uint8_t*)&g_UpdateCodePageTotal,3);
	tmpsendbuf[14] = ( g_UpdateCodePageTotal.programpage & 0xff );		
	tmpsendbuf[15] = (( g_UpdateCodePageTotal.programpage >>8 ) & 0xff );	
	tmpsendbuf[16] = ( g_RemoteUpdatePackNo & 0xff );		
	tmpsendbuf[17] = (( g_RemoteUpdatePackNo >>8 ) & 0xff );	
	if(g_UpdateType == 0xDC)
		tmpsendbuf[18] = 0;	
	else
		tmpsendbuf[18] = g_UpdateType;
	if(g_UpdateType == 1)
	{
		tmpsendbuf[19] = g_VersionHex[0];
		tmpsendbuf[20] = g_VersionHex[1];
	}
	tmpsendbuf[35] = CheckSum(31,tmpsendbuf+4);	
	tmpsendbuf[40] = CheckSum(40,tmpsendbuf);		

	SendDatatoSocket_SENDEX(updatesocketid,tmpsendbuf,41);
}

/******************************************************************
函数名称: void NetSendUpdateSuc(void)
功能描述: 向服务器发送升级成功
参数输入: 无
参数输出: 
返  回  值: 无
其      他: 无
编写者：hly
******************************************************************/
void SendUpdateSuc(uint8_t type)
{
	memset(tmpsendbuf,0,sizeof(tmpsendbuf));
	tmpsendbuf[0] = 0x5A;
	tmpsendbuf[1] = 0xA5;
	tmpsendbuf[2] = 0x10;
	tmpsendbuf[3] = 0x00;
	tmpsendbuf[4] = 0xE0;
	memcpy(tmpsendbuf+5,g_MobileInFlash.mobileno[4],6);
	TimeHexToBcd(&g_BCDTime,(uint8_t*)&g_SysTime);
	memcpy(tmpsendbuf+11,(uint8_t*)&g_BCDTime,5);
	tmpsendbuf[16] = type;		
	tmpsendbuf[19] = CheckSum(15,tmpsendbuf+4);	
	tmpsendbuf[20] = g_Send5ABagNo&0xFF;
	tmpsendbuf[21] = (g_Send5ABagNo>>8)&0xFF;
	tmpsendbuf[22] = (g_Send5ABagNo>>16)&0xFF;
	tmpsendbuf[23] = (g_Send5ABagNo>>24)&0xFF;
	tmpsendbuf[24] = CheckSum(24,tmpsendbuf);		
	SendDatatoSocket_SENDEX(updatesocketid,tmpsendbuf,25);
}

/******************************************************************
函数名称: void NetSendZhuanChuData(void)
功能描述: 向服务器发送转储数据包
参数输入: 无
参数输出: 
返  回  值: 无
其      他: 无
编写者：hly
******************************************************************/
void SendZhuanChuData(void)
{
	uint8_t FileName[13];

	uint32_t g_FileOffset,packlen;
	
	packlen = 512;
	g_FileOffset = g_PageOffset*512;
	memset(tmpsendbuf,0,sizeof(tmpsendbuf));
	
	tmpsendbuf[0] = 0x5A;
	tmpsendbuf[1] = 0xA5;
	tmpsendbuf[2] = 0x20;
	tmpsendbuf[3] = 0x02;
	tmpsendbuf[4] = 0xB0;
	memcpy( tmpsendbuf + 5 , g_MobileInFlash.mobileno[4] , 6 ); //  
	YearToStr(g_SysTime.year,(char*)&FileName);
    HexTimeToStr(g_SysTime.month,(char*)&FileName+4);  
	HexTimeToStr(g_SysTime.date,(char*)&FileName+6);   	
	memcpy(FileName+8,".txt",4);
	FileName[0]=0x32;
	FileName[12]=0;
	memcpy(tmpsendbuf + 11,FileName,12);
	
	tmpsendbuf[23] = ( g_FileSize & 0xff ); //  
	tmpsendbuf[24] = (( g_FileSize >> 8) & 0xff ); //  
	tmpsendbuf[25] = (( g_FileSize >> 16) & 0xff ); //  
	tmpsendbuf[26] = (( g_FileSize >> 24) & 0xff ); //  
	
	tmpsendbuf[27] =  ( g_FileOffset  & 0xff ); // 
	tmpsendbuf[28] =  (( g_FileOffset >> 8) & 0xff ); // 
	tmpsendbuf[29] =  (( g_FileOffset >> 16) & 0xff ); // 
	tmpsendbuf[30] =  (( g_FileOffset >> 24) & 0xff ); // 

	tmpsendbuf[31] = ( packlen & 0xff ); //
	tmpsendbuf[32] = (( packlen>> 8 ) & 0xff ); //
	tmpsendbuf[33] = (( packlen >> 16) & 0xff ); //
	tmpsendbuf[34] = (( packlen >> 24) & 0xff ); //

	W25qxx_ReadPage(g_tmpBuf,g_ZC_StartAddr+g_PageOffset*2,0,256);
	W25qxx_ReadPage(g_tmpBuf,g_ZC_StartAddr+g_PageOffset*2+1,0,256);
	memcpy( tmpsendbuf + 35 , g_tmpBuf , 512 );
	tmpsendbuf[547] = CheckSum( 543 , tmpsendbuf + 4 );
	tmpsendbuf[548] = g_Send5ABagNo&0xff;
	tmpsendbuf[549] = (g_Send5ABagNo>>8)&0xff;
	tmpsendbuf[550] = (g_Send5ABagNo>>16)&0xff;
	tmpsendbuf[551] = (g_Send5ABagNo>>24)&0xff;
	tmpsendbuf[552] = CheckSum(552 , tmpsendbuf);
	
	SendDatatoSocket_SEND(tmpsendbuf,553);
}

/******************************************************************
函数名称: void ReturnIDtoNet(void)
功能描述: 向服务器返回ID版本号
参数输入: 无
参数输出: 
返  回  值: 无
其      他: 无
******************************************************************/
void ReturnIDtoNet(void)
{
	uint8_t tmpbuf[80];
	
    memset(tmpbuf,0,sizeof(tmpbuf));

    tmpbuf[0] = 0xCF;
	tmpbuf[1] = 0x80;	
	tmpbuf[2] = 0x0B;
	tmpbuf[3] = 0x01;
	memcpy(tmpbuf+36,g_VersionAscii,4);
	memcpy(tmpbuf+40,g_VersioninFlash.bootversion, 4); 
    memset(tmpbuf + 40,0,39);	
	tmpbuf[79] = CheckSum(79,tmpbuf);	
	SendD6Data(tmpbuf,D67bit);
}


/******************************************************************
函数名称: void ReturnMobileNoToNet(void)
功能描述: 向服务器返回控制权限号
参数输入: 无
参数输出: 
返 回 值: 无
其    他: 无
******************************************************************/
void ReturnMobileNoToNet(void)
{
    uint8_t i,tmpbuf[80];

    memset(tmpbuf,0,sizeof(tmpbuf));
	
    memset(tmpbuf,0xA8,6);
    tmpbuf[6] = 0x01;

    for(i=0;i<2;i++)
    {
        memcpy(tmpbuf+7+6*i,g_MobileInFlash.mobileno[i],6);    
    }
    memset(tmpbuf+19,0xff,12);                        //路局号和工务段号
    memset(tmpbuf+31,0,4);            
    memcpy(tmpbuf+35,g_MobileInFlash.mobileno[4],6);  //本机号
    memcpy(tmpbuf+41,g_MobileInFlash.mobileno[3],6);  //短信接收号
    memset(tmpbuf+47,0,33);
    SendD6Data(tmpbuf,D67bit);
}


