/******************************************************************
函数名称: void ReturnWhiteNametoNet(void)
功能描述: 返回白名单
参数输入: 无
参数输出: 
返  回  值: 无
其      他: 无
编写者：hly
******************************************************************/
void ReturnWhiteNametoNet(void)
{
    uint8_t data[80];
    uint8_t i;

	memset(data,0,80);
    data[0] = 0xCF;
    data[1] = 0x60;
    data[2] = 0x0B;
	
	W25qxx_ReadBytes((uint8_t*)&g_Card,g_AskNamePageAddr,sizeof(g_Card));
	if(g_Card.Flag == 0xAABB)
	{
		for(i=0;i<127;i++)
		{
			if(g_Card.CardID[i] != 0)
			{
				if(i<=125)
				{
					data[7+5*i] = (g_Card.CardID[i]>>24)&0xFF;
					data[7+5*i+1] = (g_Card.CardID[i]>>16)&0xFF;
					data[7+5*i+2] = (g_Card.CardID[i]>>8)&0xFF;
					data[7+5*i+3] = g_Card.CardID[i]&0xFF;
					data[7+5*i+4] = g_AskUnit;
				}
				else
				{
					data[3] = 125;
					data[4] = 0;
					data[5] = 1;
					data[6] = 0;
					break;
				}
			}
			else
			{
				data[3] = i+1;
				data[4] = 0;
				data[5] = 1;
				data[6] = 0;
				break;
			}
		}
	}
    data[79] = CheckSum(79,data);
    SendD6Data(data,D67bit);
    g_WhiteNameSendCnt++;
}
