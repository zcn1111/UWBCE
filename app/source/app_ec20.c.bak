******************************************************************/
void ReturnPowerCtlinfotoNet(void)
{
	uint8_t tmpbuf[80];
	
    memset(tmpbuf,0,sizeof(tmpbuf));
	
    tmpbuf[0] = 0xCF;
    tmpbuf[1] = 0xFF;
    tmpbuf[2] = 0x0F;
	if(g_ResetPowerFlag <= 3)
	{
		tmpbuf[3] = g_ResetPowerFlag;
	}
    tmpbuf[79] = CheckSum(79,tmpbuf);
	SendD6Data(tmpbuf,D67bit);
	
	g_ResetPowerFlag = 0;
	WritePowerCtlFlagToFlash(g_ResetPowerFlag);
}


