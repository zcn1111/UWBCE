/******************************************************************
函数名称: void ReturnSIMModeToTool(void)
功能描述: 
参数输入: 无
参数输出: 
返 回 值: 无
其    他: 无
******************************************************************/
void ReturnSIMIccidToTool(uint8_t flag)
{
	uint8_t i;
	
	memset(g_TxBuf1,0,sizeof(g_TxBuf1));
	
    g_TxBuf1[0] = SENDTAG_SIM;
    g_TxBuf1[1] = GET_SIM_ICCID;//
    g_TxBuf1[2] = 44;
    g_TxBuf1[3] = flag;                            
    for(i=0;i<20;i++)
	{
		if(i%2 == 0)
			g_TxBuf1[4+i] = Hex2Asc((g_ICCID[flag][i/2]>>4)&0x0F);
		else
			g_TxBuf1[4+i] = Hex2Asc(g_ICCID[flag][i/2]&0x0F);
	}
	g_TxBuf1[47] = CheckSum(47*2,(uint8_t*)&g_TxBuf1);
    UartSend(&g_Uart1,(uint8_t*)&g_TxBuf1,48);
}

/******************************************************************
函数名称: void ProcessDataWithTool(void)
功能描述: 处理和客服工具的通信
参数输入: 无
参数输出: 
返 回 值: 无
其    他: 无
******************************************************************/
void ProcessDataWithTool(uint8_t *indata, uint8_t inlen)
{	
	uint8_t flag=0;
	uint32_t i;
	
    switch(indata[0])                           //判断包头
    {
        case RECEIVETAG_ALL:                    //若是通用包头
        {
            switch(indata[1])
            {               
				case SET_MY_NUMBER_TYPE:                //设置本机号
                    WriteMyNumberFromTool(indata);
                    break;
                
                case GET_MY_NUMBER_TYPE:                //索要本机号
                    ReturnMyMobileToTool();
                    break;
                
                case SET_IP_TYPE:                       //设置IP
                    WriteIPFromTool(indata);
                    break;
                
                case GET_IP_TYPE:                       //索要IP
                    ReturnIPToTool();
                    break;
				
                case GET_PARAM_INFOR_TYPE:              //索要参数信息
                    ReturnParamInforToTool();
                    break;
				
				case GET_DOOR_STATUS_TYPE:
					ReturnDoorStatusToTool();
					break;
				
				case LOCAL_OPEN_LOCK_TYPE:
					g_ToolOpenDoorFlag = 1;
					LOCK_OPENENABLE();
					g_OpenLock = true;
					g_Open1MinDelay = TIM2->CNT;
					g_ToolOpenDoorDelay = TIM2->CNT;
					g_OpenLockType = 8;
					break;
				
				case GET_MJ_SYS_PAR:
					ReturnMJParamInforToTool();
					break;
				
				case SET_LOCK_TYPE:
					{
						uint8_t hour,minute,cnt;
						if(indata[3] < 3 && indata[3] > 0 && indata[3] != g_SysPar.locktype)
						{
							g_SysPar.locktype = indata[3];
							flag = 1;
						}
						if(indata[4] <= 10 && indata[4] != g_SysPar.keeponlinetime)
						{
							if(indata[4] == 0)
								indata[4] = 3;
							g_SysPar.keeponlinetime = indata[4];
							flag = 1;
						}
						
						if(CheckNumIsBCD(indata+5,2) == true)
						{
							hour = BCDToHex(indata[5]);
							minute = BCDToHex(indata[6]);
							
							if(hour <= 23 && minute <= 59)
							{
								if(g_SysPar.updatestatustime[0]!= hour || g_SysPar.updatestatustime[1] != minute)
								{
									g_SysPar.updatestatustime[0] = indata[5];
									g_SysPar.updatestatustime[1] = indata[6];
									flag = 1;
								}
							}
						}
						cnt = indata[7];
						if(cnt > 0 && 24%cnt == 0 && g_SysPar.updatestatuscnt != cnt)
						{
							g_SysPar.updatestatuscnt = cnt;
							flag = 1;
						}
						if(flag == 1)
						{
							g_SysPar.crc16 = CRC16((uint8_t*)&g_SysPar,sizeof(g_SysPar)-2);
							UpdateAlarmPar();
							ResetRtcAlarm();
							WriteSysPar();
						}
					}
					break;
					
				case GET_LOCK_PAR:
					ReturnMJLockParamToTool();
					break;
				
				case CLR_STATUS_HISTORY:
					for(i=0;i<FLASH_STATUSDATA_LEN/4096;i++)
					{
						W25qxx_EraseSector(FLASH_STATUSDATA_START/4096+i);
					}
					InitFlashPar();
					ReturnClrHistoryToTool();
					break;
                default:
                    break;
            }
            break;
        }
		
		case RECEIVETAG_SIM:
		{
			switch(indata[1])
			{
				case SET_SIM_MODE:
					if(indata[3] < 2 && g_SysPar.simmode != indata[3])
					{
						g_SysPar.simmode = indata[3];
						WriteSysPar();						
						g_SelSIMFlag = g_SysPar.simmode;
						if(g_SelSIMFlag == SELSIM1)
							SEL_SIM1_ENABLE();
						else
							SEL_SIM2_ENABLE();
						CelluarStep = STA_PWR_OFF;
						g_NeedRebootEc20Flag = 1;
						
					}
					break;
				
				case GET_SIM_MODE:
					ReturnSIMModeToTool();
					break;
				
				case GET_SIM_ICCID:				
					if(indata[3] < 2)
					{
						g_ToolGetICCIDFlag = indata[3];
						g_ToolGetICCIDStep = 1;						
					}
					break;
				
				default:
					break;
			}
		
			break;
		}
		
        default:
            break;
    }
}

/**
 * @brief	客服工具通信
 *
 * @param	
 *
 * @return  void
 */
void ToolProcess(void)
{
	uint16_t i,j,pos,len;
	
	if(JudgeSomeDelayInProOk(g_Uart1.usTxTimer,Delay20mSec) == true && g_Uart1DirFlag == 2)
	{
		g_Uart1.SendOver();
		g_Uart1DirFlag = 1;
	}
	
	if(g_Uart1.usRxCount > 0 && JudgeSomeDelayInProOk(g_Uart1RxTimer,Delay50mSec))
	{
		memset(g_tmpBuf,0,sizeof(g_tmpBuf));
		
		if(g_Uart1.usRxCount <= UART1_RX_BUF_SIZE)
		{
			len = g_Uart1.usRxCount;
			ReadRecBuf(&g_Uart1,g_tmpBuf,g_Uart1.usRxCount);			
		}
		else
		{
			ReadRecBuf(&g_Uart1,g_tmpBuf,UART1_RX_BUF_SIZE);
			g_Uart1.usRxCount = 0;
			g_Uart1.usRxRead = 0;
			g_Uart1.usRxWrite = 0;
			memset(g_RxBuf1,0,UART1_RX_BUF_SIZE);
			len = UART1_RX_BUF_SIZE;
		}
		
		if(g_tmpBuf[0] == 0xEE && g_tmpBuf[1] == 0xEE && g_tmpBuf[15] == CheckSum(15,g_tmpBuf))
		{
			memcpy((uint8_t*)&g_UpdateCodePageTotal,g_tmpBuf+8,3);
			
			g_UpdateCodePageTotal.programpage = Get16ValueFrom8Buf(g_tmpBuf,11);
			if(g_UpdateCodePageTotal.programtype != CODETYPE)
			{
				g_ToolCodeTypeErrorFlag = 1;
				g_ToolCommandFlag = 1;
				g_ToolBaowenFlag = 1;
			}
			else
			{
				g_ToolCodeTypeErrorFlag = 0;
				MajorVersion = g_tmpBuf[9];  
				MinorVersion = g_tmpBuf[10];
				j = (g_UpdateCodePageTotal.programpage *496)/w25qxx.SectorSize+1;
				for(i=0;i<j;i++)
				{
					W25qxx_EraseSector(FLASH_IAP_USER_START1/w25qxx.SectorSize+i);
				}
				g_LocalUpdateFlag = 1;					
				g_LocalUpdateQuestPageNo = 0;
				g_ToolCommandFlag = 1;
				g_ToolBaowenFlag = 1;
				NormalUpdateFileSize.FileSize = 0;
				WriteNormalFileSizeToFlash();
			}
		}
		else if(g_tmpBuf[0] == 0xDC && g_tmpBuf[1] == 0xDC && g_tmpBuf[511] == CheckSum(511,g_tmpBuf))
		{
			if((StrNcmpString(g_tmpBuf+7,(uint8_t*)&g_UpdateCodePageTotal,3,&pos) == 0)
				&& (g_tmpBuf[10] == (g_UpdateCodePageTotal.programpage&0xFF)) 
				&& g_tmpBuf[11] == (g_UpdateCodePageTotal.programpage>>8)
				&&( Get16ValueFrom8Buf( g_tmpBuf , 12 ) == g_LocalUpdateQuestPageNo))					
			{
				memcpy(g_UartUPBuf,g_tmpBuf+14,496);
				W25q_Write_N(g_UartUPBuf,FLASH_IAP_USER_START1+496*g_LocalUpdateQuestPageNo,496);								
				W25qxx_ReadBytes(g_checkbuf,FLASH_IAP_USER_START1+496*g_LocalUpdateQuestPageNo,496);		
				if(memcmp(g_UartUPBuf,g_checkbuf,496) == 0)
					g_LocalUpdateQuestPageNo++;	
				g_LocalUpdateFlag = 2;
				g_ToolBaowenFlag = 1;	
				g_ToolCommandFlag = 1;
				g_ToolResendFlag = 0;
			}
		}
		else if(g_tmpBuf[0] == RECEIVETAG_ALL || g_tmpBuf[0] == RECEIVETAG_SIM)
		{
			ProcessDataWithTool(g_tmpBuf,len);
		}		
	}
	
	//发送处理
	if(JudgeSomeDelayInProOk(g_Uart1.usTxTimer,Delay300mSec) == true && g_ToolPowerOn == 1 && g_Uart1DirFlag == 1)
	{
		if(g_ToolOpenDoorFlag == 1 && JudgeSomeDelayInProOk(g_ToolOpenDoorDelay,Delay1Sec) == true)
		{
			ReturnDoorStatusToTool();
			g_ToolOpenDoorFlag = 0;
		}
		else if(g_ToolGetICCIDStep == 3)
		{
			ReturnSIMIccidToTool(g_ToolGetICCIDFlag);
			g_ToolGetICCIDStep = 0;
		}
		else if(g_ToolBaowenFlag == 1)
		{
			if(g_ToolCommandFlag == 1)		//升级
			{
				if(g_LocalUpdateFlag == 1 || g_LocalUpdateFlag == 2)
				{
					g_LocalUpdateFlag = 0;
					Local_Update_Quest();
					if(g_ShouldJumpToStartFlag == 0)
					{
						g_ToolResendTimers = 20;
						g_ToolResendFlag = 1;
						g_ToolRecTimer = TIM2->CNT;
					}
				}
				else if(g_ToolCodeTypeErrorFlag == 1)
				{
					Local_Update_Quest();
					g_ToolCommandFlag = 0;
				}
			}
//			else if(g_ToolCommandFlag == 2)	//转储
//			{
//			
//			}
//			
			g_ToolBaowenFlag = 0;
		}
		else if(g_ShouldJumpToStartFlag == 2)
		{
			g_ShouldJumpToStartFlag = 0;
			SoftReset();
		}
		
		
		//未收到升级包重新请求
		if(g_ToolCommandFlag == 1 && g_ToolResendFlag == 1 && g_ToolResendTimers!=0
			 &&g_LocalUpdateFlag != 0 && JudgeSomeDelayInProOk(g_ToolRecTimer,Delay100mSec) == true)
		{
			g_LocalUpdateFlag = 0;
			Local_Update_Quest();
			g_ToolResendTimers--;
			g_ToolRecTimer = TIM2->CNT;
		}
	}
}






