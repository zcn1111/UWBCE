    g_TxBuf1[2] = 12;
	g_TxBuf1[3] = g_LockMGAStatus;
	g_TxBuf1[4] = g_LockHeadStatus;
	g_TxBuf1[5] = 0xFE;
	g_TxBuf1[6] = 0xFE;
	g_TxBuf1[7] = 0;
	g_TxBuf1[8] = 0;
	g_TxBuf1[9] = 0xFE;
