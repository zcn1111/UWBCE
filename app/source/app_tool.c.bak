void ReturnMJParamInforToTool(void)
{
	uint8_t i;
	
	memset(g_TxBuf1,0,sizeof(g_TxBuf1));
	
    g_TxBuf1[0] = SENDTAG_ALL;
    g_TxBuf1[1] = GET_MJ_SYS_PAR;//
    g_TxBuf1[2] = 20;
    g_TxBuf1[3] = 0;                            
    g_TxBuf1[4] = g_SysPar.locktype;    
    g_TxBuf1[11] = g_SysPar.closelockdelay;  
    g_TxBuf1[12] = g_SysPar.keeponlinetime;             
	for(i=0;i<6;i++)    
		g_TxBuf1[16+i] = g_BTMac[i];
	g_TxBuf1[22] = 1;
	g_TxBuf1[23] = CheckSum(23*2,(uint8_t*)&g_TxBuf1);
    UartSend(&g_Uart1,(uint8_t*)&g_TxBuf1,24);
}

